{
  "name": "agentnest",
  "version": "0.0.0",
  "private": true,
  "description": "AgentNest pre-alpha desktop foundation; no agent runtime or AI integration yet.",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "start": "node scripts/desktop.mjs start",
    "build": "node scripts/desktop.mjs build",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings=0 && npm run check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:md": "node scripts/check-docs.mjs lint",
    "check:links": "node scripts/check-docs.mjs links",
    "check:structure": "node scripts/check-docs.mjs structure",
    "check": "npm run lint:md && npm run check:links && npm run check:structure"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "markdown-it": "15.0.3",
    "markdownlint": "0.42.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
