{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.browser.config.ts",
    "tests/browser/**/*.ts",
    "tests/e2e/**/*.ts",
    "packages/**/*.test.ts",
    "apps/desktop/electron/**/*.test.ts"
  ],
  "exclude": [
    "packages/runtime/**/*.test.ts",
    "packages/provider-ollama/**/*.test.ts"
  ]
}
